# .env.example
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=mailing_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Почта (для тестов оставляем консоль, для продакшена раскомментируй SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
